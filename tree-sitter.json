{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "cromo",
      "camelcase": "Cromo",
      "scope": "source.cro",
      "path": ".",
      "file-types": [
        "cro"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^(cromo|cro)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Cromo grammar for tree-sitter",
    "authors": [
      {
        "name": "The Cromo authors"
      }
    ]
  }
}
